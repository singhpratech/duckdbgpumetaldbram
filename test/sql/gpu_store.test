# gpu_store SQL test — resident table columns (docs/RESIDENT_COLUMNS_DESIGN.md, stage B):
# gpu_upload_columns(tag, rowid, BIGINT[] cols, DOUBLE[] cols, VARCHAR[] cols) uploads columns
# of a table into its STORE in row-id order; a plain identity tag whose lanes are all in the
# store is answered by a VIEW that shares them; gpu_store_columns() lists them and
# gpu_drop_column() frees one. Parity is checked in-process against native SQL.
#
# Run via: ./scripts/run_sql_tests.sh gpu_store

-- 1. Two statements over one table share the store's columns: k,v and k,v,z are views, three columns resident, views own nothing
-- setup: CREATE TABLE t AS SELECT (i % 100)::INTEGER AS k, (i % 7)::BIGINT AS v, (i % 5)::INTEGER AS z FROM range(300000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SET VARIABLE st = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v,z:store'
-- setup: SET VARIABLE s1 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v'
-- setup: SET VARIABLE s2 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v,z'
-- setup: SELECT gpu_upload_columns(getvariable('st'), rowid, [k::BIGINT, v, z::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM t
-- setup: SELECT count(*) FROM gpu_groupby_exact_resident(getvariable('s1'))
-- setup: SELECT count(*) FROM gpu_groupby_exact_resident_where(getvariable('s2'), 'i0 = 2')
SELECT (SELECT count(*) FROM (SELECT key, sum FROM gpu_groupby_exact_resident(getvariable('s1')) EXCEPT SELECT k, sum(v) FROM t GROUP BY k)) + (SELECT count(*) FROM (SELECT k, sum(v) FROM t GROUP BY k EXCEPT SELECT key, sum FROM gpu_groupby_exact_resident(getvariable('s1')))) AS mismatch1,
       (SELECT count(*) FROM (SELECT key, sum, count_star FROM gpu_groupby_exact_resident_where(getvariable('s2'), 'i0 = 2') EXCEPT SELECT k, sum(v), count(*) FROM t WHERE z = 2 GROUP BY k)) AS mismatch2,
       (SELECT count(*) FROM gpu_store_columns() WHERE store = 'gpudb:v1:memory:main:t:' || getvariable('oid')) AS store_cols,
       (SELECT count(*) FROM gpu_residents() WHERE kind = 'view') AS views,
       (SELECT sum(bytes) FROM gpu_residents() WHERE kind = 'view') AS view_bytes,
       (SELECT bool_and(bytes > 0) FROM gpu_store_columns()) AS columns_cost;
-- expect: 0  0  3  2  0  true

-- 2. A VARCHAR column as the key (its dictionary shared with every view; a NULL s is the tuple text 'N', decoded back to NULL), a DOUBLE predicate lane
-- setup: CREATE TABLE t AS SELECT CASE WHEN i % 9 = 0 THEN NULL ELSE ['a','bb','ccc'][1 + i % 3] END AS s, (i % 11)::BIGINT AS v, (i % 3) / 2.0 AS d, CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 4)::INTEGER END AS z FROM range(200000) r(i)
-- setup: CREATE MACRO tup(x) AS CASE WHEN x IS NULL THEN 'N' ELSE strlen(CAST(x AS VARCHAR))::VARCHAR || ':' || CAST(x AS VARCHAR) END
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SET VARIABLE st = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':v,z,d,s:store'
-- setup: SET VARIABLE s1 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':s,v,z,d'
-- setup: SELECT gpu_upload_columns(getvariable('st'), rowid, [v, z::BIGINT], [d], [tup(s)]) FROM t
SELECT (SELECT count(*) FROM (SELECT d.c0, r.sum, r.count, r.count_star FROM gpu_groupby_exact_resident_where(getvariable('s1'), 'i0 = 1; f0 > 0.4') r LEFT JOIN gpu_resident_dictionary(getvariable('s1'), 1) d ON d.id = r.key EXCEPT SELECT s, sum(v), count(v), count(*) FROM t WHERE z = 1 AND d > 0.4 GROUP BY s)) +
       (SELECT count(*) FROM (SELECT s, sum(v), count(v), count(*) FROM t WHERE z = 1 AND d > 0.4 GROUP BY s EXCEPT SELECT d.c0, r.sum, r.count, r.count_star FROM gpu_groupby_exact_resident_where(getvariable('s1'), 'i0 = 1; f0 > 0.4') r LEFT JOIN gpu_resident_dictionary(getvariable('s1'), 1) d ON d.id = r.key)) AS mismatch,
       (SELECT count(*) FROM gpu_groupby_exact_resident(getvariable('s1')) WHERE key IS NULL) AS null_key_groups,
       (SELECT dtype FROM gpu_store_columns() WHERE "column" = 's') AS s_dtype;
-- expect: 0  0  STR

-- 3. Segmented upload in REVERSE row-id order lands in row-id order: the store is row-aligned across scans (a second lane uploaded separately joins the first)
-- setup: CREATE TABLE t AS SELECT (i % 50)::INTEGER AS k, i::BIGINT AS v, (i * 3)::BIGINT AS w FROM range(120000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SET VARIABLE st1 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v:store'
-- setup: SET VARIABLE st2 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':w:store'
-- setup: SET VARIABLE s1 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,w,v'
-- setup: SELECT gpu_upload_begin(getvariable('st1'))
-- setup: SELECT gpu_upload_columns(getvariable('st1'), rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t WHERE rowid >= 80000
-- setup: SELECT gpu_upload_columns(getvariable('st1'), rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t WHERE rowid >= 40000 AND rowid < 80000
-- setup: SELECT gpu_upload_columns(getvariable('st1'), rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t WHERE rowid < 40000
-- setup: SELECT gpu_upload_finish(getvariable('st1'))
-- setup: SELECT gpu_upload_columns(getvariable('st2'), rowid, [w], []::DOUBLE[], []::VARCHAR[]) FROM t
SELECT (SELECT count(*) FROM (SELECT key, sum, count_star FROM gpu_groupby_exact_resident_where(getvariable('s1'), 'i0 < 30000') EXCEPT SELECT k, sum(w), count(*) FROM t WHERE v < 30000 GROUP BY k)) +
       (SELECT count(*) FROM (SELECT k, sum(w), count(*) FROM t WHERE v < 30000 GROUP BY k EXCEPT SELECT key, sum, count_star FROM gpu_groupby_exact_resident_where(getvariable('s1'), 'i0 < 30000'))) AS mismatch,
       (SELECT count(*) FROM gpu_store_columns()) AS store_cols,
       (SELECT rows FROM gpu_store_columns() WHERE "column" = 'w') AS w_rows;
-- expect: 0  3  120000

-- 4. Guards and lifetime: gpu_assert_rows sees a view; gpu_drop_column frees a lane and every view on it
-- setup: CREATE TABLE t AS SELECT (i % 10)::INTEGER AS k, i::BIGINT AS v FROM range(100000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SET VARIABLE st = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v:store'
-- setup: SET VARIABLE s1 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v'
-- setup: SELECT gpu_upload_columns(getvariable('st'), rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t
-- setup: SELECT count(*) FROM gpu_groupby_exact_resident(getvariable('s1'))
-- setup: SET VARIABLE guard = gpu_assert_rows(getvariable('s1'), 100000)
-- setup: SET VARIABLE ready_views = (SELECT count(*) FROM gpu_residents() WHERE kind = 'view' AND state = 'ready')
-- setup: SET VARIABLE dropped = gpu_drop_column('gpudb:v1:memory:main:t:' || getvariable('oid'), 'v')
SELECT getvariable('guard') AS guard_ok, getvariable('ready_views') AS ready_views, getvariable('dropped') AS dropped,
       (SELECT count(*) FROM gpu_residents() WHERE kind = 'view') AS views_after_drop,
       (SELECT count(*) FROM gpu_store_columns()) AS cols_after_drop;
-- expect: true  1  true  0  1

-- 4b. A write invalidates the store (its prefix) and every view on it
-- setup: CREATE TABLE t AS SELECT (i % 10)::INTEGER AS k, i::BIGINT AS v FROM range(100000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v:store', rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t
-- setup: SELECT count(*) FROM gpu_groupby_exact_resident('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v')
-- setup: SET VARIABLE n = gpu_invalidate('gpudb:v1:memory:main:t:' || getvariable('oid'))
SELECT getvariable('n') >= 2 AS invalidated_store_and_view,
       (SELECT count(*) FROM gpu_store_columns()) AS cols_after,
       (SELECT count(*) FROM gpu_residents() WHERE kind = 'view' AND state = 'stale') AS stale_views;
-- expect: true  0  1

-- 5. A view without a payload (count(*) only, the tag's '-' lane) over the store
-- setup: CREATE TABLE t AS SELECT (i % 10)::INTEGER AS k, CASE WHEN i % 3 = 0 THEN NULL ELSE i END::BIGINT AS n FROM range(60000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,n:store', rowid, [k::BIGINT, n], []::DOUBLE[], []::VARCHAR[]) FROM t
SELECT (SELECT count(*) FROM (SELECT key, count_star FROM gpu_groupby_exact_resident_where('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,-,n', 'i0 is not null') EXCEPT SELECT k, count(*) FROM t WHERE n IS NOT NULL GROUP BY k)) +
       (SELECT count(*) FROM (SELECT k, count(*) FROM t WHERE n IS NOT NULL GROUP BY k EXCEPT SELECT key, count_star FROM gpu_groupby_exact_resident_where('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,-,n', 'i0 is not null'))) AS mismatch;
-- expect: 0

-- 6. A view over a store that lacks a lane is no set: the operator says so (the wrapper uploads the missing lane)
-- setup: CREATE TABLE t AS SELECT (i % 10)::INTEGER AS k, i::BIGINT AS v, (i % 3)::INTEGER AS z FROM range(1000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v:store', rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t
-- expected_fail: no resident set named
SELECT count(*) FROM gpu_groupby_exact_resident('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v,z');

-- 7. A scrambled scan (what a lane behind a correlated subquery looks like: the join hands its rows back in another order) is placed by row-id rank at finish — the placed lanes stay row-aligned with an ordered upload, NULL cells and a VARCHAR lane included
-- setup: CREATE TABLE t AS SELECT (i % 40)::INTEGER AS k, i::BIGINT AS v, CASE WHEN i % 7 = 0 THEN NULL ELSE (i % 9)::BIGINT END AS n, ['a','bb','ccc','dddd'][1 + i % 4] AS s FROM range(150000) r(i)
-- setup: CREATE MACRO tup(x) AS CASE WHEN x IS NULL THEN 'N' ELSE strlen(CAST(x AS VARCHAR))::VARCHAR || ':' || CAST(x AS VARCHAR) END
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SET VARIABLE s1 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,n'
-- setup: SET VARIABLE s2 = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':s,v,n'
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k:store', rowid, [k::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM t
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:t:' || getvariable('oid') || ':v,n,s:store', rid, [v, n], []::DOUBLE[], [tup(s)]) FROM (SELECT rowid AS rid, v, n, s FROM t ORDER BY hash(rowid))
SELECT (SELECT count(*) FROM (SELECT key, sum, count, count_star FROM gpu_groupby_exact_resident(getvariable('s1')) EXCEPT SELECT k, sum(n), count(n), count(*) FROM t GROUP BY k)) +
       (SELECT count(*) FROM (SELECT k, sum(n), count(n), count(*) FROM t GROUP BY k EXCEPT SELECT key, sum, count, count_star FROM gpu_groupby_exact_resident(getvariable('s1')))) AS mismatch_placed_nulls,
       (SELECT count(*) FROM (SELECT d.c0, r.sum, r.count_star FROM gpu_groupby_exact_resident_where(getvariable('s2'), 'i0 = 3') r LEFT JOIN gpu_resident_dictionary(getvariable('s2'), 1) d ON d.id = r.key EXCEPT SELECT s, sum(v), count(*) FROM t WHERE n = 3 GROUP BY s)) +
       (SELECT count(*) FROM (SELECT s, sum(v), count(*) FROM t WHERE n = 3 GROUP BY s EXCEPT SELECT d.c0, r.sum, r.count_star FROM gpu_groupby_exact_resident_where(getvariable('s2'), 'i0 = 3') r LEFT JOIN gpu_resident_dictionary(getvariable('s2'), 1) d ON d.id = r.key)) AS mismatch_placed_str,
       (SELECT count(*) FROM gpu_store_columns()) AS store_cols,
       (SELECT rows FROM gpu_store_columns() WHERE "column" = 's') AS s_rows;
-- expect: 0  0  4  150000

-- 8. A join materialised over two base VIEWS. A view is not a durable object: it lives
-- only as long as every lane it names is in the store, so a set built from one is only
-- as resident as the store behind it. This is what a caller holding the join must
-- re-derive rather than remember.
-- setup: CREATE TABLE f AS SELECT (i % 100)::INTEGER AS g, (i % 7)::BIGINT AS v, (i % 50)::INTEGER AS fk FROM range(120000) r(i)
-- setup: CREATE TABLE d AS SELECT i::INTEGER AS id, (i % 5)::INTEGER AS attr FROM range(50) r(i)
-- setup: SET VARIABLE fo = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 'f')
-- setup: SET VARIABLE dq = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 'd')
-- setup: SET VARIABLE p = 'gpudb:v1:memory:main:f:' || getvariable('fo') || ':g,v,fk:join'
-- setup: SET VARIABLE b = 'gpudb:v1:memory:main:d:' || getvariable('dq') || ':id,attr:join'
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:f:' || getvariable('fo') || ':g,v,fk:store', rowid, [g::BIGINT, v, fk::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM f
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:d:' || getvariable('dq') || ':id,attr:store', rowid, [id::BIGINT, attr::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM d
-- setup: SET VARIABLE rows = gpu_join_materialize('jv', getvariable('p'), 'i0', getvariable('b'), 'k', 'p.k, p.v, b.v')
SELECT getvariable('rows') AS joined_rows,
       (SELECT count(*) FROM (SELECT key, sum, count_star FROM gpu_groupby_exact_resident('jv') EXCEPT SELECT g, sum(f.v), count(*) FROM f JOIN d ON f.fk = d.id GROUP BY g)) +
       (SELECT count(*) FROM (SELECT g, sum(f.v), count(*) FROM f JOIN d ON f.fk = d.id GROUP BY g EXCEPT SELECT key, sum, count_star FROM gpu_groupby_exact_resident('jv'))) AS mismatch,
       (SELECT count(*) FROM gpu_residents() WHERE kind = 'view') AS views;
-- expect: 120000  0  2

-- 8b. A lane the probe view reads is evicted: the view goes with it, so the set built
-- from it reports the source that changed rather than answering from a dead handle
-- setup: CREATE TABLE f AS SELECT (i % 100)::INTEGER AS g, (i % 7)::BIGINT AS v, (i % 50)::INTEGER AS fk FROM range(120000) r(i)
-- setup: CREATE TABLE d AS SELECT i::INTEGER AS id, (i % 5)::INTEGER AS attr FROM range(50) r(i)
-- setup: SET VARIABLE fo = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 'f')
-- setup: SET VARIABLE dq = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 'd')
-- setup: SET VARIABLE p = 'gpudb:v1:memory:main:f:' || getvariable('fo') || ':g,v,fk:join'
-- setup: SET VARIABLE b = 'gpudb:v1:memory:main:d:' || getvariable('dq') || ':id,attr:join'
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:f:' || getvariable('fo') || ':g,v,fk:store', rowid, [g::BIGINT, v, fk::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM f
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:d:' || getvariable('dq') || ':id,attr:store', rowid, [id::BIGINT, attr::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM d
-- setup: SET VARIABLE rows = gpu_join_materialize('jv', getvariable('p'), 'i0', getvariable('b'), 'k', 'p.k, p.v, b.v')
-- setup: SET VARIABLE dropped = gpu_drop_column('gpudb:v1:memory:main:f:' || getvariable('fo'), 'fk')
-- expected_fail: was joined from
SELECT count(*) FROM gpu_groupby_exact_resident('jv');

-- 8c. ... and materialising it again over the same names says there is no such set,
-- until the lane is uploaded again, when the same call succeeds
-- setup: CREATE TABLE f AS SELECT (i % 100)::INTEGER AS g, (i % 7)::BIGINT AS v, (i % 50)::INTEGER AS fk FROM range(120000) r(i)
-- setup: CREATE TABLE d AS SELECT i::INTEGER AS id, (i % 5)::INTEGER AS attr FROM range(50) r(i)
-- setup: SET VARIABLE fo = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 'f')
-- setup: SET VARIABLE dq = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 'd')
-- setup: SET VARIABLE p = 'gpudb:v1:memory:main:f:' || getvariable('fo') || ':g,v,fk:join'
-- setup: SET VARIABLE b = 'gpudb:v1:memory:main:d:' || getvariable('dq') || ':id,attr:join'
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:f:' || getvariable('fo') || ':g,v,fk:store', rowid, [g::BIGINT, v, fk::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM f
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:d:' || getvariable('dq') || ':id,attr:store', rowid, [id::BIGINT, attr::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM d
-- setup: SET VARIABLE dropped = gpu_drop_column('gpudb:v1:memory:main:f:' || getvariable('fo'), 'fk')
-- expected_fail: no resident set named
SELECT gpu_join_materialize('jv', getvariable('p'), 'i0', getvariable('b'), 'k', 'p.k, p.v, b.v');

-- 8d. The lane uploaded again: the view is synthesised once more and the join lands
-- setup: CREATE TABLE f AS SELECT (i % 100)::INTEGER AS g, (i % 7)::BIGINT AS v, (i % 50)::INTEGER AS fk FROM range(120000) r(i)
-- setup: CREATE TABLE d AS SELECT i::INTEGER AS id, (i % 5)::INTEGER AS attr FROM range(50) r(i)
-- setup: SET VARIABLE fo = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 'f')
-- setup: SET VARIABLE dq = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 'd')
-- setup: SET VARIABLE p = 'gpudb:v1:memory:main:f:' || getvariable('fo') || ':g,v,fk:join'
-- setup: SET VARIABLE b = 'gpudb:v1:memory:main:d:' || getvariable('dq') || ':id,attr:join'
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:f:' || getvariable('fo') || ':g,v,fk:store', rowid, [g::BIGINT, v, fk::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM f
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:d:' || getvariable('dq') || ':id,attr:store', rowid, [id::BIGINT, attr::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM d
-- setup: SET VARIABLE dropped = gpu_drop_column('gpudb:v1:memory:main:f:' || getvariable('fo'), 'fk')
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:f:' || getvariable('fo') || ':fk:store', rowid, [fk::BIGINT], []::DOUBLE[], []::VARCHAR[]) FROM f
SELECT gpu_join_materialize('jv', getvariable('p'), 'i0', getvariable('b'), 'k', 'p.k, p.v, b.v') AS joined_rows,
       (SELECT count(*) FROM gpu_store_columns() WHERE store = 'gpudb:v1:memory:main:f:' || getvariable('fo')) AS f_cols;
-- expect: 120000  3

-- 9. gpu_store_columns().width: the bytes a row of the lane is stored at (stage C).
-- A lane is kept at the narrowest signed width its values fit, so three columns of
-- the same 120000 rows cost 1, 2 and 8 bytes a row and say so. NULL where the
-- backend leaves no width note (a CPU-only build), which is why the check reads
-- 'width IS NULL OR width = n'.
-- setup: CREATE TABLE t AS SELECT (i % 100)::INTEGER AS small, (i % 30000)::INTEGER AS mid, (i * 1000000000)::BIGINT AS big, (i % 3) / 2.0 AS d FROM range(120000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SET VARIABLE st = 'gpudb:v1:memory:main:t:' || getvariable('oid') || ':small,mid,big,d:store'
-- setup: SELECT gpu_upload_columns(getvariable('st'), rowid, [small::BIGINT, mid::BIGINT, big], [d], []::VARCHAR[]) FROM t
SELECT (SELECT width IS NULL OR width = 1 FROM gpu_store_columns() WHERE "column" = 'small') AS small_width,
       (SELECT width IS NULL OR width = 2 FROM gpu_store_columns() WHERE "column" = 'mid') AS mid_width,
       (SELECT width IS NULL OR width = 8 FROM gpu_store_columns() WHERE "column" = 'big') AS big_width,
       (SELECT width IS NULL OR width = 8 FROM gpu_store_columns() WHERE "column" = 'd') AS double_width,
       (SELECT bool_and(rows = 120000) FROM gpu_store_columns()) AS every_column_reports_rows,
       (SELECT bool_and(width IS NULL OR width IN (1, 2, 4, 8)) FROM gpu_store_columns()) AS widths_are_lane_widths;
-- expect: true  true  true  true  true  true

-- 10. New columns of gpu_store_columns() are APPENDED, so a caller that reads the
-- table positionally keeps reading the values it always did: `width` stays the
-- fourteenth and `on_gpu` is the fifteenth.
-- setup: CREATE TABLE t AS SELECT (i % 100)::INTEGER AS k, i::BIGINT AS v FROM range(120000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v:store', rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t
SELECT (SELECT list(column_name) FROM (DESCRIBE SELECT * FROM gpu_store_columns()))[14] AS fourteenth,
       (SELECT list(column_name) FROM (DESCRIBE SELECT * FROM gpu_store_columns()))[-1] AS last_column,
       (SELECT count(*) FROM (DESCRIBE SELECT * FROM gpu_store_columns())) AS columns;
-- expect: width  on_gpu  15

-- 11. gpu_store_columns().on_gpu: which side the lane actually landed on. An
-- upload routes to the GPU where there is one, so on a GPU build every lane is
-- on the device; a lane that is NOT would be what a device refusal used to leave
-- behind, and it is what makes a later operator say "columns are resident on
-- different backends". NULL where no backend installs a placement reporter, and
-- an absent answer is not "on the host" — which is why the check reads
-- 'on_gpu IS NULL OR on_gpu'.
-- setup: CREATE TABLE t AS SELECT (i % 100)::INTEGER AS k, i::BIGINT AS v FROM range(120000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
-- setup: SELECT gpu_upload_columns('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v:store', rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t
SELECT (SELECT bool_and(on_gpu IS NULL OR on_gpu) FROM gpu_store_columns()) AS nothing_on_the_host,
       (SELECT count(*) FROM gpu_store_columns() WHERE on_gpu IS NOT NULL AND NOT on_gpu) AS host_lanes;
-- expect: true  0

-- 12. An exact upload the DEVICE refuses is reported, not placed on the host:
-- the statement raises rather than quietly producing a set that would answer from
-- the CPU reference (slower than DuckDB, rule 1) and would mix with device lanes
-- of the same store. GPUDB_METAL_UPLOAD_REFUSE_MB makes the Metal backend refuse
-- any exact upload above that many MiB, which is the only way to reach this on a
-- machine with memory to spare.
-- requires_backend: metal
-- env: GPUDB_METAL_UPLOAD_REFUSE_MB=1
-- setup: CREATE TABLE t AS SELECT (i % 100)::INTEGER AS k, i::BIGINT AS v FROM range(300000) r(i)
-- setup: SET VARIABLE oid = (SELECT table_oid FROM duckdb_tables() WHERE table_name = 't')
SELECT gpu_upload_columns('gpudb:v1:memory:main:t:' || getvariable('oid') || ':k,v:store', rowid, [k::BIGINT, v], []::DOUBLE[], []::VARCHAR[]) FROM t;
-- expected_fail: the device refused the upload; a host-placed exact set is not offered in its place
