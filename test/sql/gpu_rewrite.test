SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql('SELECT k, sum(v) AS s FROM t GROUP BY k'), getvariable('ctx')));

-- 17. EXACT SET (v0.7 §4): NULL keys and payloads, the full aggregate set, native names and types — identical rows
-- setup: CREATE TABLE t AS SELECT CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 7)::BIGINT END AS k, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 3 - 100)::BIGINT END AS v, (i % 50)::INTEGER AS a, ((i % 977) / 100.0)::DECIMAL(15,2) AS d FROM range(100000) r(i)
-- setup: SELECT gpu_upload_rows_exact('gpudb:v1:memory:main:t:9:k,v,a,d', k, v, [a::BIGINT], [d::DOUBLE]) FROM t
-- setup: SET VARIABLE ctx = '{"tag":"gpudb:v1:memory:main:t:9:k,v,a,d","exact":true,"table":{"catalog":"memory","schema":"main","name":"t","oid":9},"columns":{"k":"BIGINT","v":"BIGINT","a":"INTEGER","d":"DOUBLE"},"backend":"METAL","rows":100000,"ready":true,"default_order":"ASC","outputs":[{"name":"k","type":"BIGINT"},{"name":"sum(v)","type":"HUGEINT"},{"name":"count(v)","type":"BIGINT"},{"name":"count_star()","type":"BIGINT"},{"name":"min(v)","type":"BIGINT"},{"name":"max(v)","type":"BIGINT"},{"name":"avg(v)","type":"DOUBLE"}],"thresholds":{"min_rows":1000}}'
-- setup: SET VARIABLE q = 'SELECT k, sum(v), count(v), count(*), min(v), max(v), avg(v) FROM t GROUP BY k'
SELECT json_extract_string(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx')), '$.gpudb.reason') AS reason,
       (SELECT count(*) FROM (SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))) EXCEPT SELECT k, sum(v), count(v), count(*), min(v), max(v), avg(v) FROM t GROUP BY k)) AS extra,
       (SELECT count(*) FROM (SELECT k, sum(v), count(v), count(*), min(v), max(v), avg(v) FROM t GROUP BY k EXCEPT SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))))) AS missing,
       (SELECT count(*) FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx')))) AS groups_with_null_key;
-- expect: rewritten  0  0  8

-- 18. EXACT: WHERE becomes the _where program (integer, DOUBLE, IN, BETWEEN, IS NOT NULL, a key predicate); identical rows
-- setup: CREATE TABLE t AS SELECT CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 7)::BIGINT END AS k, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 3 - 100)::BIGINT END AS v, CASE WHEN i % 17 = 0 THEN NULL ELSE (i % 50)::INTEGER END AS a, ((i % 977) / 100.0)::DOUBLE AS d FROM range(100000) r(i)
-- setup: SELECT gpu_upload_rows_exact('gpudb:v1:memory:main:t:9:k,v,a,d', k, v, [a::BIGINT], [d]) FROM t
-- setup: SET VARIABLE ctx = '{"tag":"gpudb:v1:memory:main:t:9:k,v,a,d","exact":true,"table":{"catalog":"memory","schema":"main","name":"t","oid":9},"columns":{"k":"BIGINT","v":"BIGINT","a":"INTEGER","d":"DOUBLE"},"backend":"METAL","rows":100000,"ready":true,"default_order":"ASC","outputs":[{"name":"k","type":"BIGINT"},{"name":"sum(v)","type":"HUGEINT"},{"name":"count_star()","type":"BIGINT"}],"thresholds":{"min_rows":1000}}'
-- setup: SET VARIABLE q = 'SELECT k, sum(v), count(*) FROM t WHERE a > 5 AND d <= 7.5 AND a IN (7, 9, 11, 13) AND a BETWEEN 6 AND 40 AND v IS NOT NULL AND k >= 1 GROUP BY k'
SELECT json_extract_string(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx')), '$.gpudb.reason') AS reason,
       (SELECT count(*) FROM (SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))) EXCEPT SELECT k, sum(v), count(*) FROM t WHERE a > 5 AND d <= 7.5 AND a IN (7, 9, 11, 13) AND a BETWEEN 6 AND 40 AND v IS NOT NULL AND k >= 1 GROUP BY k)) AS extra,
       (SELECT count(*) FROM (SELECT k, sum(v), count(*) FROM t WHERE a > 5 AND d <= 7.5 AND a IN (7, 9, 11, 13) AND a BETWEEN 6 AND 40 AND v IS NOT NULL AND k >= 1 GROUP BY k EXCEPT SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))))) AS missing,
       json_deserialize_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))) LIKE '%gpu_groupby_exact_resident_where(''gpudb:v1:memory:main:t:9:k,v,a,d'', ''i0 > 5%f0 <= 7.5%i0 in (7, 9, 11, 13)%i0 >= 6%i0 <= 40%v is not null%k >= 1'')%' AS program;
-- expect: rewritten  0  0  true

-- 19. EXACT: HAVING on the device for sum / count(*) / min with > >= < <=; on the host for = and avg; identical rows
-- setup: CREATE TABLE t AS SELECT CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 7)::BIGINT END AS k, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 3 - 100)::BIGINT END AS v FROM range(100000) r(i)
-- setup: SELECT gpu_upload_rows_exact('gpudb:v1:memory:main:t:9:k,v', k, v, [], []) FROM t
-- setup: SET VARIABLE ctx = '{"tag":"gpudb:v1:memory:main:t:9:k,v","exact":true,"table":{"catalog":"memory","schema":"main","name":"t","oid":9},"columns":{"k":"BIGINT","v":"BIGINT"},"backend":"METAL","rows":100000,"ready":true,"default_order":"ASC","outputs":[{"name":"k","type":"BIGINT"},{"name":"s","type":"HUGEINT"}],"thresholds":{"min_rows":1000}}'
SELECT (SELECT count(*) FROM ((SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql('SELECT k, sum(v) AS s FROM t GROUP BY k HAVING count(*) >= 14000'), getvariable('ctx')))) EXCEPT (SELECT k, sum(v) AS s FROM t GROUP BY k HAVING count(*) >= 14000))) + (SELECT count(*) FROM ((SELECT k, sum(v) AS s FROM t GROUP BY k HAVING count(*) >= 14000) EXCEPT (SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql('SELECT k, sum(v) AS s FROM t GROUP BY k HAVING count(*) >= 14000'), getvariable('ctx')))))) AS cs_dev,
       json_deserialize_sql(gpu_rewrite_ast(json_serialize_sql('SELECT k, sum(v) AS s FROM t GROUP BY k HAVING min(v) < -50'), getvariable('ctx'))) LIKE '%_having(''gpudb:v1:memory:main:t:9:k,v'', ''min'', ''<'', -50)%' AS min_dev,
       (SELECT count(*) FROM ((SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql('SELECT k, sum(v) AS s FROM t GROUP BY k HAVING avg(v) > 149000'), getvariable('ctx')))) EXCEPT (SELECT k, sum(v) AS s FROM t GROUP BY k HAVING avg(v) > 149000))) + (SELECT count(*) FROM ((SELECT k, sum(v) AS s FROM t GROUP BY k HAVING avg(v) > 149000) EXCEPT (SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql('SELECT k, sum(v) AS s FROM t GROUP BY k HAVING avg(v) > 149000'), getvariable('ctx')))))) AS avg_host,
       (SELECT count(*) FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql('SELECT k, sum(v) AS s FROM t GROUP BY k HAVING count(*) = 13187'), getvariable('ctx')))) = (SELECT count(*) FROM (SELECT k FROM t GROUP BY k HAVING count(*) = 13187)) AS eq_host,
       json_extract_string(gpu_rewrite_ast(json_serialize_sql('SELECT k, sum(v) AS s FROM t GROUP BY k HAVING count(*) = 13187'), getvariable('ctx')), '$.gpudb.form') AS form;
-- expect: 0  true  0  true  having

-- 20. EXACT: top-k by sum / count(*) / max pushes _topk with the aggregate name; identical rows
-- setup: CREATE TABLE t AS SELECT CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 700)::BIGINT END AS k, CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 3 - 100)::BIGINT END AS v FROM range(100000) r(i)
