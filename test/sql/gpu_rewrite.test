       (SELECT count(*) FROM (SELECT k, sum(d), min(d), max(d) FROM t WHERE p > 2.55 AND p <= 30 GROUP BY k HAVING sum(d) > 2000.005 EXCEPT SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))))) AS missing,
       (SELECT typeof("sum(d)") || ' ' || typeof("min(d)") FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))) LIMIT 1) AS types,
       json_deserialize_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))) LIKE '%_where_having(''gpudb:v1:memory:main:t:9:k,d,p'', ''i0 > 25%i0 <= 300'', ''sum'', ''>'', 200000)%' AS rescaled;
