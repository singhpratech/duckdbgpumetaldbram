       (SELECT string_agg(k || ':' || m, ' ' ORDER BY m DESC, k) FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx')))) = (SELECT string_agg(k || ':' || m, ' ' ORDER BY m DESC, k) FROM (SELECT k, max(v) AS m FROM t GROUP BY k ORDER BY m DESC LIMIT 5)) AS same_rows;
