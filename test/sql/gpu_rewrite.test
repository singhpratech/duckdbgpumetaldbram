       (SELECT count(*) FROM (SELECT d, sum(v), count(*) FROM t WHERE ts >= TIMESTAMP '2020-01-01 06:00:00.5' AND d2 BETWEEN DATE '1995-06-01' AND DATE '1996-06-01' AND d <> DATE '1995-03-03' GROUP BY d EXCEPT SELECT * FROM json_execute_serialized_sql(gpu_rewrite_ast(json_serialize_sql(getvariable('q')), getvariable('ctx'))))) AS missing,
