# DuckDB pre-built shared libs (~140 MB; fetched by scripts/get_duckdb_libs.sh).
# Both spellings: the trailing slash matches only a directory, and a worktree
# reaches these through a symlink to the main checkout's copy.
third_party/duckdb-libs/
third_party/duckdb-libs

# community-extensions CI build dirs (created by the root Makefile / extension-ci-tools)
cmake_build/
configure/
duckdb_unittest_tempdir/

# Private working notes — never committed (strategy, drafts, plans)
.private/

# pip packaging output. The extension binary the platform wheel carries is
# copied into python/gpudb/_ext/ by scripts/build_wheels.sh and taken out
# again; it is a build product and is never committed.
python/gpudb/_ext/
python/dist/
